{
  "schema_version": 1,
  "limits": {
    "max_dart_file_lines": 400,
    "max_public_exports": 20,
    "max_agents_lines": 120,
    "max_handoff_lines": 160,
    "max_exception_days": 30
  },
  "required_files": [
    "AGENTS.md",
    "docs/00_AI_HANDOFF.md",
    "docs/01_ARCHITECTURE.md",
    "docs/02_SECURITY_MODEL.md",
    "docs/03_IMPLEMENTATION_PLAN.md",
    "docs/04_ACCEPTANCE_CRITERIA.md",
    "docs/07_AI_GOVERNANCE.md",
    "docs/08_MOBILE_BOOTSTRAP_SESSION_CONTRACT.md",
    "docs/09_F0_02_IMPLEMENTATION_HANDOFF.md",
    "docs/DEBT_REGISTER.md",
    "docs/STATUS.md",
    "docs/DECISIONS.md",
    "governance/exceptions.json",
    "governance/public_api.txt",
    "governance/api_surface.snapshot",
    "tool/governance_test.dart",
    ".github/pull_request_template.md",
    ".github/workflows/governance.yml"
  ],
  "allowed_task_states": ["READY", "IN_PROGRESS", "BLOCKED", "DONE"],
  "secret_scan_ignore_paths": [
    ".git",
    ".dart_tool",
    "build",
    "governance/policy.json",
    "test/fixtures"
  ],
  "forbidden_source_patterns": [
    {
      "id": "SEC-MOBILE-SECRET",
      "pattern": "\\b(appSecret|clientSecret|providerSecret)\\b",
      "case_sensitive": false,
      "reason": "Mobile SDK must not expose long-lived shared secrets.",
      "examples_match": ["final String appSecret;"],
      "examples_ignore": ["final String appId;"]
    },
    {
      "id": "SEC-CLIENT-CREDENTIALS",
      "pattern": "client_credentials",
      "case_sensitive": false,
      "reason": "OAuth client credentials belong to a trusted server.",
      "examples_match": ["grantType = 'client_credentials'"],
      "examples_ignore": ["restoreSession()"]
    },
    {
      "id": "ARCH-DIRECT-PROVIDER",
      "pattern": "\\b(openai|s3\\.amazonaws|aliyun|twilio|sendgrid)\\b",
      "case_sensitive": false,
      "reason": "SDK capabilities must call Nebula platform ports, not providers.",
      "examples_match": ["openai.createCompletion()"],
      "examples_ignore": ["nebulaAi.createTask()"]
    },
    {
      "id": "DATA-TRUST-BODY-APP-ID",
      "pattern": "['\"]app_id['\"]\\s*:",
      "case_sensitive": false,
      "reason": "Trusted app scope must not be authored by mobile request bodies.",
      "examples_match": ["{'app_id': appId}"],
      "examples_ignore": ["options.appId"]
    }
  ]
}
